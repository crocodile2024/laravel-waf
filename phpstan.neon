includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    paths:
        - src
    tmpDir: build/phpstan
    checkMissingIterableValueType: true
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # apcu_* nur vorhanden, wenn die Erweiterung geladen ist
        - '#Function apcu_(fetch|store|enabled) not found#'
